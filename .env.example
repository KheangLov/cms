# Copy to .env and fill in real values for local dev.
# This file is the single source of config for every service in infra/docker-compose.yml.

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only-not-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Encrypts secret Settings values (AI provider API keys, etc — §5.8). Dev default below
# is a valid Fernet key; generate a real one for any shared/prod environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=dx39U2u_6sftD3A7dfMr_c7Jz_O01VyST65AbiiFxyU=

# ---------- PostgreSQL ----------
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Valkey (Redis-protocol-compatible — cache, Celery broker, Channels layer) ----------
# See CMS_BUILD_PROMPT.md §2 for why Valkey over Redis. Var is named REDIS_URL because
# every client library (django-redis, celery, channels-redis) expects that name — Valkey
# speaks the same wire protocol so nothing else needs to know it isn't literally Redis.
REDIS_URL=redis://valkey:6379/0

# ---------- Elasticsearch ----------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---------- MinIO (S3-compatible object storage) ----------
MINIO_ROOT_USER=cms_minio_admin
MINIO_ROOT_PASSWORD=change-me-dev-only
AWS_STORAGE_BUCKET_NAME=cms-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# ---------- Frontend (Nuxt) ----------
# Browser-side: reaches the backend via its published host port. 8010, not 8000 — an
# unrelated project on this machine already owns 8000 (see infra/docker-compose.yml).
NUXT_PUBLIC_API_BASE=http://localhost:8010
# Server-side (SSR, runs inside the frontend container): reaches the backend via the
# Docker network's service name on its internal port — unaffected by the host remap above.
NUXT_API_BASE_INTERNAL=http://backend:8000
